# FRONTEND SERVER: replace both example URLs with your own domains.
# Backend origin for the server-side proxy and hosted forms (no /api/v1).
# Set before npm run build. Rebuild after a change; keep the same at runtime.
API_ORIGIN=https://api.example.com

# Public FRONTEND origin for canonical metadata, sitemap and robots.
# This value is public. Set before npm run build and rebuild after changes.
NEXT_PUBLIC_SITE_URL=https://app.example.com

# Examples for local development instead:
# API_ORIGIN=http://127.0.0.1:4000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only origin URLs: no path, query, fragment or credentials.
# Never put SMTP, Redis, database or JWT secrets in the frontend environment.
